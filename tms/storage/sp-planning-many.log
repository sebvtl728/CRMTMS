select distinct enrolment_adjustments.enrolment_id, seances.training_session_id, to_char(seances.date, 'YYYY-MM') as month from "enrolment_adjustments" inner join "seances" on "seances"."id" = "enrolment_adjustments"."seance_id" where "enrolment_adjustments"."enrolment_id" in (?, ?, ?, ?, ?, ?) and "enrolment_adjustments"."kind" = ? and "seances"."deleted_at" is null and "seances"."status" <> ?
select "training_session_id", "month" from "attendance_closures" where "training_session_id" in (?) and "closed_at" is not null and "attendance_closures"."tenant_id" = ? order by "month" asc
select attendances.enrolment_id as enrolment_id, seances.training_session_id as session_id, to_char(seances.date, 'YYYY-MM') as month, sum(attendances.minutes)::bigint as realised, sum(case when seances.date < ?::date and attendances.status = ? then coalesce(own.duration_minutes, seances.duration_minutes) when seances.date < ?::date and attendances.status = ? then greatest(coalesce(own.duration_minutes, seances.duration_minutes) - attendances.minutes, 0) else 0 end)::bigint as absent from "attendances" inner join "seances" on "seances"."id" = "attendances"."seance_id" inner join "enrolments" on "enrolments"."id" = "attendances"."enrolment_id" left join "enrolment_adjustments" as "own" on "own"."seance_id" = "attendances"."seance_id" and "own"."enrolment_id" = "attendances"."enrolment_id" and "own"."starts_at" is not null where "attendances"."enrolment_id" in (?, ?, ?, ?, ?, ?) and "seances"."deleted_at" is null and "seances"."status" <> ? and ("enrolments"."entered_on" is null or "seances"."date" >= "enrolments"."entered_on") and ("enrolments"."left_on" is null or "seances"."date" <= "enrolments"."left_on") and "attendances"."tenant_id" = ? group by attendances.enrolment_id, seances.training_session_id, to_char(seances.date, 'YYYY-MM')
select monthly_hours.enrolment_id as enrolment_id, monthly_hours.session_module_id as module_id, to_char(monthly_hours.month, 'YYYY-MM') as month, sum(monthly_hours.minutes)::bigint as minutes from "monthly_hours" inner join "enrolments" on "enrolments"."id" = "monthly_hours"."enrolment_id" where "monthly_hours"."enrolment_id" in (?, ?, ?, ?, ?, ?) and ("enrolments"."entered_on" is null or monthly_hours.month >= date_trunc('month', enrolments.entered_on)::date) and ("enrolments"."left_on" is null or monthly_hours.month <= date_trunc('month', enrolments.left_on)::date) and "monthly_hours"."tenant_id" = ? group by monthly_hours.enrolment_id, monthly_hours.session_module_id, to_char(monthly_hours.month, 'YYYY-MM')
select training_session_id, to_char(date, 'YYYY-MM') as month, sum(duration_minutes)::bigint as minutes from "seances" where 0 = 1 and "status" = ? and "date" < ? and "seances"."tenant_id" = ? and "seances"."deleted_at" is null group by training_session_id, to_char(date, 'YYYY-MM')

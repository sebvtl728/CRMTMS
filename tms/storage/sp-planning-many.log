select "dossiers"."id" from "dossiers" where "dossiers"."status" not in (?, ?) and exists (select 1 from "enrolments" inner join "training_sessions" on "training_sessions"."id" = "enrolments"."training_session_id" where "enrolments"."dossier_id" = "dossiers"."id" and "enrolments"."status" in (?, ?, ?) and "training_sessions"."deleted_at" is null and "training_sessions"."starts_on" <= ?) and "dossiers"."tenant_id" = ? and "dossiers"."deleted_at" is null

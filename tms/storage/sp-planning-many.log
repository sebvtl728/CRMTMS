select "enrolments"."dossier_id", min(training_sessions.starts_on) as starts_on, max(training_sessions.ends_on) as ends_on from "enrolments" inner join "training_sessions" on "training_sessions"."id" = "enrolments"."training_session_id" where "enrolments"."status" not in (?, ?) and "training_sessions"."status" <> ? and "training_sessions"."deleted_at" is null and "enrolments"."dossier_id" in (?, ?, ?, ?, ?, ?) group by "enrolments"."dossier_id"

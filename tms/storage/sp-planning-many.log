select * from "invoices" where "kind" = ? and "status" in (?, ?) and "due_on" is not null and "due_on" < ? and (invoices.total_ttc_cents - coalesce((select -sum(c.total_ttc_cents) from invoices c where c.corrected_invoice_id = invoices.id and c.kind = 'credit_note' and c.status in ('validated', 'sent')), 0) - (select coalesce(sum(pa.amount_cents), 0) from payment_allocations pa where pa.invoice_id = invoices.id)) > 0 and not exists (select 1 from "invoice_reminder_pauses" as "rp" where "rp"."invoice_id" = "invoices"."id") and not exists (select 1 from "invoice_sendings" as "rs" where "rs"."invoice_id" = "invoices"."id" and "rs"."purpose" = ? and ("rs"."status" = ? or ("rs"."status" = ? and "rs"."reminder_level" >= ?))) and ("dossier_id" in (select "dossiers"."id" from "dossiers" where "dossiers"."tenant_id" = ? and "dossiers"."deleted_at" is null) or "origin" = ?) and "invoices"."tenant_id" = ? order by "due_on" asc, "number" asc limit 500

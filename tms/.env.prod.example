# Production environment (read by compose.prod.yaml and ops/*.sh).
# The installer generates .env from this list; never commit real values.
# Required variables are marked (obligatoire).
#
# Updates (ops/update.sh) add to .env every key of this file that .env does not have yet:
#   KEY=value          the default value is copied;
#   KEY=__GENERATE__   a random secret is generated (32 bytes, base64 url-safe), also by the installer;
#   KEY=               nothing is added (optional setting, empty by default).

# --- Image -------------------------------------------------------------------
# Full image name without tag; default ghcr.io/${TMS_IMAGE_OWNER}/tms
TMS_IMAGE=
TMS_IMAGE_OWNER=
# Release tag to run (obligatoire)
TMS_VERSION=
# Digest (sha256:...) of that version's image, from the verified release bundle (release.env);
# written by the installer and the updater. Empty: the tag alone is pulled (local builds).
TMS_IMAGE_DIGEST=

# --- Public address ----------------------------------------------------------
# DNS name served by Caddy, certificate via Let's Encrypt (obligatoire)
TMS_DOMAIN=
# Contact e-mail for the ACME account (obligatoire)
TMS_ACME_EMAIL=
# Certificates: acme (default, public DNS + ports 80/443 reachable) or internal (Caddy local CA, LAN only)
TMS_TLS=
# Host ports published by Caddy (defaults 80 / 443)
TMS_HTTP_PORT=
TMS_HTTPS_PORT=
# Internal network; Caddy's fixed address is the only proxy trusted for X-Forwarded-*
TMS_NET_SUBNET=
TMS_CADDY_IP=

# --- Application -------------------------------------------------------------
APP_NAME=
# base64:... generated with `php artisan key:generate --show` (obligatoire)
APP_KEY=
# single (one organisme) or multi (tenant by host name)
TMS_MODE=
TMS_DEFAULT_TENANT=
# Recipient of operational alerts (failed backup, failed update)
TMS_ALERT_EMAIL=
LOG_LEVEL=
# Accept private-network (RFC 1918) SMTP relays in connectors; default true in single mode, false in multi
TMS_ALLOW_PRIVATE_SMTP_HOSTS=

# --- Database / cache (obligatoire) -------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=

# --- Instance mail (alerts, activation links) -----------------------------------
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=

# --- Backups (ops/backup.sh) ----------------------------------------------------
# Encryption passphrase of the restic repository (obligatoire). Keep a copy outside
# the server: without it the backups cannot be read.
RESTIC_PASSWORD=
# Local repository (default /var/backups/tms)
RESTIC_REPOSITORY=
# Optional second copy (restic URL: s3:..., rest:..., sftp:...)
RESTIC_REMOTE_REPOSITORY=
# Passphrase of the remote repository (default: RESTIC_PASSWORD)
RESTIC_REMOTE_PASSWORD=
# File of KEY=VALUE credentials for the remote backend (e.g. AWS_ACCESS_KEY_ID)
RESTIC_REMOTE_ENV_FILE=
# Staging directory for the dump (default /var/tmp)
TMS_BACKUP_TMPDIR=
